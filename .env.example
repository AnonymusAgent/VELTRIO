DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# One fixed account: alomukhtar@playhub.vom (no registration or external sign-in).
# Only used to provision an account when it does not exist. Never overwrites a changed password.
# Generate a unique 12+ character password and keep it private.
ADMIN_INITIAL_PASSWORD=
# Optional initial one-time recovery code. You can generate a new one in Admin > Settings.
ADMIN_RECOVERY_CODE=
# Optional embedded preview mode (secure partitioned cookies). Keep 0 for standalone production.
ADMIN_EMBEDDED_PREVIEW=0

# Use an absolute path on a persistent, writable volume in production.
# Both the database and this directory must be backed up.
UPLOAD_DIR=.data/uploads
UPLOAD_STORAGE_GB=10

# Optional Google AdSense, subject to publisher approval and applicable consent requirements.
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_HEADER=
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=
NEXT_PUBLIC_ADSENSE_SLOT_INFEED=
NEXT_PUBLIC_ADSENSE_SLOT_VIDEO=
NEXT_PUBLIC_ADSENSE_SLOT_FOOTER=
NEXT_PUBLIC_ADSENSE_SLOT_RESPONSIVE=
