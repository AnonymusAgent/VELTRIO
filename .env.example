# Direct (non-pooled) PostgreSQL connection. Used by Drizzle schema commands.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
# Optional pooled runtime connection. Recommended for Neon on serverless hosts.
DATABASE_URL_POOLED=
# Vercel preview builds skip migrations unless this is explicitly set to true.
# Enable only after both preview database URLs point to an isolated database.
ALLOW_PREVIEW_DB_MIGRATIONS=false
# Neon Auth for user accounts. Configure the auth URL in Neon and generate a random 32+ character secret.
# The admin studio continues to use its separate built-in login.
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# One fixed account: alimukhtar@veltrio.com (no registration or external sign-in).
# Only used to provision an account when it does not exist. Never overwrites a changed password.
# Generate a unique 12+ character password and keep it private.
ADMIN_INITIAL_PASSWORD=
# Optional initial one-time recovery code. You can generate a new one in Admin > Settings.
ADMIN_RECOVERY_CODE=
# Optional embedded preview mode (secure partitioned cookies). Keep 0 for standalone production.
ADMIN_EMBEDDED_PREVIEW=0

# Current upload driver is local filesystem. Use a persistent writable volume in production.
# Both the database and this directory must be backed up.
STORAGE_PROVIDER=local
UPLOAD_DIR=.data/uploads
UPLOAD_STORAGE_GB=10
# For durable Vercel Blob uploads, set STORAGE_PROVIDER=vercel_blob and provide this token.
# Keep STORAGE_PROVIDER=local when using the persistent-volume adapter.
BLOB_READ_WRITE_TOKEN=
UPLOAD_CLEANUP_AGE_HOURS=24

# Mux streaming (required for creator uploads on serverless hosts such as Vercel,
# where the local filesystem is read-only and ephemeral).
# 1. Create a Mux environment and copy the API access token ID + secret below.
# 2. Set MUX_ENABLED=true. Uploads, playback tokens and posters then go live.
# 3. Point MUX_CORS_ORIGIN at the exact public origin that will upload.
# MUX_API_BASE_URL / MUX_STREAM_BASE_URL / MUX_IMAGE_BASE_URL exist only for
# tests and local fakes; leave them blank in any real deployment.
MUX_ENABLED=false
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
# Optional. Enables /api/mux/webhook asset-state updates; register
# https://<your-domain>/api/mux/webhook in the Mux dashboard, then paste the
# signing secret here. Uploads still finalize by polling without it.
MUX_WEBHOOK_SECRET=
# Optional. Enables signed playback (short-lived RS256 tokens). Public playback
# IDs work without these; enable them for paid or private catalogues.
MUX_PLAYBACK_SIGNING_KEY_ID=
MUX_PLAYBACK_PRIVATE_KEY=
# Exact application origin; use a separate origin and Mux environment for previews.
MUX_CORS_ORIGIN=
# Cost-control default; 2160p allows 4K only when a suitable source is processed.
MUX_MAX_RESOLUTION=1080p
MUX_TEST_MODE=true

# Optional first-party pre-roll video, deployed under public/. No ad is played when blank.
# Example: put a licensed clip at public/sponsors/promo.mp4 and set /sponsors/promo.mp4.
VIDEO_PREROLL_PATH=
# Optional legacy AdSense publisher ID for ads.txt only; it does not enable display or video ads.
NEXT_PUBLIC_ADSENSE_CLIENT=
