# Direct (non-pooled) PostgreSQL connection. Used by Drizzle schema commands.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
# Optional pooled runtime connection. Recommended for Neon on serverless hosts.
DATABASE_URL_POOLED=
# Neon Auth for user accounts. Configure the auth URL in Neon and generate a random 32+ character secret.
# The admin studio continues to use its separate built-in login.
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# One fixed account: alimukhtar@veltrio.com (no registration or external sign-in).
# Only used to provision an account when it does not exist. Never overwrites a changed password.
# Generate a unique 12+ character password and keep it private.
ADMIN_INITIAL_PASSWORD=
# Optional initial one-time recovery code. You can generate a new one in Admin > Settings.
ADMIN_RECOVERY_CODE=
# Optional embedded preview mode (secure partitioned cookies). Keep 0 for standalone production.
ADMIN_EMBEDDED_PREVIEW=0

# Current upload driver is local filesystem. Use a persistent writable volume in production.
# Both the database and this directory must be backed up.
STORAGE_PROVIDER=local
UPLOAD_DIR=.data/uploads
UPLOAD_STORAGE_GB=10
# For durable Vercel Blob uploads, set STORAGE_PROVIDER=vercel_blob and provide this token.
# Keep STORAGE_PROVIDER=local when using the persistent-volume adapter.
BLOB_READ_WRITE_TOKEN=
UPLOAD_CLEANUP_AGE_HOURS=24

# Optional Google AdSense, subject to publisher approval and applicable consent requirements.
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_HEADER=
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=
NEXT_PUBLIC_ADSENSE_SLOT_INFEED=
NEXT_PUBLIC_ADSENSE_SLOT_VIDEO=
NEXT_PUBLIC_ADSENSE_SLOT_FOOTER=
NEXT_PUBLIC_ADSENSE_SLOT_RESPONSIVE=
